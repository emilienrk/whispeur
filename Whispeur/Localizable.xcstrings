    "À 0, la transcription est reproductible. Plus haute = plus de variété, mais aussi plus d'erreurs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 0, transcription is reproducible. Higher = more variety, but also more errors."
          }
        }
      }
    },
