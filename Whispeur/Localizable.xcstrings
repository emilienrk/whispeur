    "Si la proba de silence dépasse ce seuil, le segment est ignoré. Augmenter réduit les hallucinations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If silence probability exceeds this threshold, the segment is ignored. Increasing reduces hallucinations."
          }
        }
      }
    },
