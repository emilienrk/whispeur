    "Collage automatique": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic pasting"
          }
        }
      }
    },
    "Avec l'autorisation d'Accessibilité, Whispeur colle le texte directement dans l'application active. Sans elle, le texte est copié dans le presse-papier — vous collez avec ⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Accessibility access, Whispeur pastes text straight into the active app. Without it, text is copied to the clipboard — paste it with ⌘V."
          }
        }
      }
    },
    "Accessibilité autorisée": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility allowed"
          }
        }
      }
    },
    "Vérifier à nouveau": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        }
      }
    },
    "Modèle de transcription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription model"
          }
        }
      }
    },
    "Le modèle tourne sur votre Mac. Le téléchargement n'a lieu qu'une fois.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model runs on your Mac. It is downloaded only once."
          }
