        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispeur needs the microphone to capture your voice. Without it, dictation cannot work."
          }
        }
      }
    },
    "Autoriser le microphone": {
      "extractionState": "manual",
      "localizations": {
