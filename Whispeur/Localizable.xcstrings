    "Tout est prêt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are all set"
          }
        }
      }
    },
    "Whispeur vit dans la barre de menus. Retrouvez-y vos modèles, votre historique et vos réglages.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
